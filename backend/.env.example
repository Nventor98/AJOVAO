NAIJALIFE_APP_ENV=development
NAIJALIFE_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
NAIJALIFE_DATABASE_URL=postgresql+psycopg://naijalife:replace-me@localhost:5432/naijalife
NAIJALIFE_REDIS_URL=redis://localhost:6379/0
NAIJALIFE_JOB_BACKEND=inline

# Configure all three Twilio values to enable SMS delivery.
AIJALIFE_TWILIO_ACCOUNT_SID=
NAIJALIFE_TWILIO_AUTH_TOKEN=
NAIJALIFE_TWILIO_FROM_NUMBER=

# Product-owner policy values; confirm before launch.
NAIJALIFE_PRICE_INDEX_MIN_SAMPLES=5
NAIJALIFE_PRICE_INDEX_MIN_SOURCES=2
NAIJALIFE_PRICE_OBSERVATION_MAX_AGE_DAYS=30
NAIJALIFE_SAVINGS_BASELINE_MAX_AGE_DAYS=30
NAIJALIFE_SAVINGS_BASELINE_MIN_SAMPLES=5
NAIJALIFE_SAVINGS_BASELINE_MIN_SOURCES=2
NAIJALIFE_SAVINGS_BASELINE_RADIUS_KM=50
NAIJALIFE_PRICE_ANOMALY_RATIO=3
# Zero disables external demand-signal publication until the Product Owner approves a threshold.
NAIJALIFE_DEMAND_SIGNAL_MIN_HOUSEHOLDS=0
